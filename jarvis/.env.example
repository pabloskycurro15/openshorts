# JARVIS — configuración del núcleo (copiar a .env)
# Puerto y host del núcleo. Por defecto solo escucha en localhost.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=7777
# Directorio de datos (base de datos, token local, copias). Por defecto ./.data
JARVIS_DATA_DIR=./.data
# Nivel de log: fatal | error | warn | info | debug | trace
JARVIS_LOG_LEVEL=info
# Las claves de proveedores de IA NO van aquí en texto plano a partir de la Fase 3:
# se guardarán en el almacén de credenciales cifrado. Ver SECURITY.md.
