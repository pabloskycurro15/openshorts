{
  "name": "jarvis",
  "version": "0.9.0",
  "private": true,
  "description": "JARVIS — asistente personal inteligente multimodal",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w @jarvis/core",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev:web": "npm run dev -w @jarvis/web",
    "build:web": "npm run build -w @jarvis/web",
    "desktop": "npm run start -w @jarvis/desktop",
    "dist:win": "npm run dist:win -w @jarvis/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
