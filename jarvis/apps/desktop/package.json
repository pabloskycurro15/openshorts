{
  "name": "@jarvis/desktop",
  "version": "1.3.0",
  "private": true,
  "description": "JARVIS — aplicación de escritorio",
  "author": "JARVIS",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "npm run build -w @jarvis/web && node build.mjs",
    "start": "node build.mjs && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "es.jarvis.asistente",
    "productName": "JARVIS",
    "copyright": "JARVIS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json",
      "!**/node_modules/@huggingface/transformers/.cache/**",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/@huggingface/transformers/dist/*.web*",
      "!**/node_modules/@huggingface/transformers/dist/transformers.js",
      "!**/node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!**/node_modules/@huggingface/transformers/dist/ort-*",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/linux/*/libonnxruntime_providers_cuda*",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/linux/*/libonnxruntime_providers_tensorrt*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/{linux,darwin}/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
        "!**/node_modules/@img/*-{linux,linuxmusl,darwin}-*/**",
        "!**/node_modules/@img/sharp-wasm32/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "JARVIS",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "JARVIS-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/{win32,darwin}/**",
        "!**/node_modules/@img/*-{win32,darwin}-*/**",
        "!**/node_modules/@img/sharp-wasm32/**"
      ]
    },
    "electronVersion": "45.5.0",
    "executableName": "JARVIS",
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JARVIS usa el micrófono solo cuando le hablas (botón o palabra «Jarvis»).",
        "NSAppleEventsUsageDescription": "JARVIS controla las ventanas y aplicaciones que tú autorices (traer al frente, minimizar, cerrar).",
        "NSSpeechRecognitionUsageDescription": "JARVIS transcribe lo que le dices para entender tus órdenes."
      },
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/{linux,win32}/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v*/darwin/x64/**",
        "!**/node_modules/@img/*-{linux,linuxmusl,win32}-*/**",
        "!**/node_modules/@img/*-darwin-x64/**",
        "!**/node_modules/@img/sharp-wasm32/**"
      ]
    },
    "dmg": {
      "artifactName": "JARVIS-${version}-Mac-${arch}.${ext}",
      "title": "JARVIS ${version}"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@whiskeysockets/baileys": "7.0.0-rc14"
  }
}
